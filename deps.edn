{:paths ["src"]
 ;; the oldest jolt runtime this works on: 0.8.26 is where a dependency's
 ;; :jolt/native spec can name the task that builds it, which is how a
 ;; project that depends on this one gets the libraries built (0.8.4 began
 ;; resolving a dependency's relative paths against its own deps.edn)
 :jolt/min-version "0.8.26"
 ;; libjoltc and the shim are built by the `native` task (native/build.sh,
 ;; which fetches joltc at a pinned commit; nothing third-party is
 ;; committed here). jolt runs it in this library's checkout the first time
 ;; a project requires one of its namespaces and the libraries are not
 ;; there, once for both, then opens them. The relative paths resolve
 ;; against this file, for a project that depends on this one too; the bare
 ;; names are for a shipped game, which carries the libraries beside its
 ;; binary. No :windows candidates: the build does not make them, and
 ;; without the key the platform's own search for joltc.dll and
 ;; joltc_shim.dll is what is tried.
 :jolt/native [{:name "joltc" :build "native"
                :darwin ["native/lib/libjoltc.dylib" "libjoltc.dylib"]
                :linux ["native/lib/libjoltc.so" "libjoltc.so"]}
               {:name "joltc_shim" :build "native"
                :darwin ["native/lib/libjoltc_shim.dylib" "libjoltc_shim.dylib"]
                :linux ["native/lib/libjoltc_shim.so" "libjoltc_shim.so"]}]
 :aliases {:test {:extra-paths ["test"]}
           :examples {:extra-paths ["examples"]}
           ;; the example with a window: raylib-jlt binds the system's
           ;; libraylib 6.0 (`brew install raylib`), which is why it is an
           ;; alias of its own and not something :examples needs
           :raylib {:extra-paths ["examples"]
                    :extra-deps {net.b12n/raylib {:git/url "https://github.com/jlt-commons/raylib-jlt.git"
                                                  :git/sha "ffd97a91727b02c8f2a5ee2c194bfb64d10c2d4a"
                                                  :deps/root "lib"}}}
           ;; regenerate the bindings from the checkout the build made
           :gen {:extra-deps {io.github.noonian/jolt-bindgen {:git/sha "ee52050696e7d6e1be131d440fac898d283d07f0"}}
                 :main-opts ["-m" "noonian.jolt.bindgen.main" "gen/manifest.edn"]}}
 :tasks {native "sh native/build.sh"
         test "jolt -A:test -e \"(require 'joltc.layout-test 'clojure.test) (clojure.test/run-tests 'joltc.layout-test)\""}}
