{:paths ["src"]
 ;; the oldest jolt runtime this works on: 0.8.4 is where a dependency's
 ;; relative :jolt/native path began to resolve against its own deps.edn,
 ;; which is how a project that depends on this one finds the libraries
 :jolt/min-version "0.8.4"
 ;; libjoltc and the shim are built by `jolt native` (native/build.sh, which
 ;; fetches joltc at a pinned commit; nothing third-party is committed here).
 ;; The paths are relative to this file, for a project that depends on this
 ;; one too. :optional, so a project without the build still loads and
 ;; `joltc.shim/available?` says whether physics will work. No :windows
 ;; candidates: the build does not make them, and without the key the
 ;; platform's own search for joltc.dll and joltc_shim.dll is what is tried.
 :jolt/native [{:name "joltc" :optional true
                :darwin ["native/lib/libjoltc.dylib"]
                :linux ["native/lib/libjoltc.so"]}
               {:name "joltc_shim" :optional true
                :darwin ["native/lib/libjoltc_shim.dylib"]
                :linux ["native/lib/libjoltc_shim.so"]}]
 :aliases {:test {:extra-paths ["test"]}
           :examples {:extra-paths ["examples"]}
           ;; the example with a window: raylib-jlt binds the system's
           ;; libraylib 6.0 (`brew install raylib`), which is why it is an
           ;; alias of its own and not something :examples needs
           :raylib {:extra-paths ["examples"]
                    :extra-deps {net.b12n/raylib {:git/url "https://github.com/jlt-commons/raylib-jlt.git"
                                                  :git/sha "ffd97a91727b02c8f2a5ee2c194bfb64d10c2d4a"
                                                  :deps/root "lib"}}}
           ;; regenerate the bindings from the checkout the build made
           :gen {:extra-deps {io.github.noonian/jolt-bindgen {:git/sha "ee52050696e7d6e1be131d440fac898d283d07f0"}}
                 :main-opts ["-m" "noonian.jolt.bindgen.main" "gen/manifest.edn"]}}
 :tasks {native "sh native/build.sh"
         test "jolt -A:test -e \"(require 'joltc.layout-test 'clojure.test) (clojure.test/run-tests 'joltc.layout-test)\""}}
