(ns joltc.ffi
  "Generated by jolt-bindgen from joltc.h (joltc 886e088 (Jolt 5.6.0)). Do not edit by hand."
  (:require [jolt.ffi :as ffi]))

(def bindgen-target
  "The target these bindings are loaded as. JOLT_BINDGEN_TARGET overrides the
  detection: it loads them as one of the extracted targets on a platform that
  is not among them, which nothing has checked."
  (let [os (str (System/getProperty "os.name"))
        arch (str (System/getProperty "os.arch"))
        detected (str (cond (re-find #"(?i)android" os) "android"
                            (re-find #"(?i)mac|darwin" os) "darwin"
                            (re-find #"(?i)win" os) "windows"
                            :else "linux")
                      "-" (if (re-find #"(?i)aarch64|arm64" arch) "arm64" "x86_64"))
        target (or (System/getenv "JOLT_BINDGEN_TARGET") detected)]
    (when-not (contains? #{"darwin-arm64" "linux-x86_64" "windows-x86_64"} target)
      (throw (ex-info (str "joltc.ffi has no bindings for " target ": they were extracted for darwin-arm64, linux-x86_64, windows-x86_64. Extract them there and regenerate, or set JOLT_BINDGEN_TARGET to one of those to load as it.")
                      {:target target :detected detected :extracted ["darwin-arm64" "linux-x86_64" "windows-x86_64"]})))
    target))

